<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - PROGRES.NG BPS Bangka Tengah</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .dashboard-compact-container { padding: 1rem 1.25rem !important; }
        .stat-card-compact { padding: 0.88rem 0.95rem !important; min-height: 106px; }
        .stat-card-compact .stat-label { font-size: 0.68rem; letter-spacing: 0.25px; }
        .stat-card-compact .stat-value { font-size: 1.35rem; line-height: 1.15; }
        .stat-card-compact .stat-sub { font-size: 0.68rem; margin-top: 0.25rem !important; }
        .table-compact-dash th, .table-compact-dash td { padding: 0.44rem 0.55rem !important; font-size: 0.8rem; }
        .status-row-compact { padding-top: 0.5rem !important; padding-bottom: 0.5rem !important; font-size: 0.8rem; }
        .sidebar-brand-sisurat { display: flex; align-items: center; gap: 0.75rem; text-align: left !important; }
        
        .navbar-custom-uniform {
            padding-top: 0.75rem !important;
            padding-bottom: 0.75rem !important;
        }
        .brand-title-small {
            font-size: 0.875rem !important;
        }
        .realtime-clock-modern {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(6px);
            border: 1px solid rgba(226, 232, 240, 0.8);
            color: #475569;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.3rem 0.8rem;
            border-radius: 50rem;
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        }
        /* Style pill TA selector ala referensi */
        .ta-pill-dropdown {
            background: #ffffff;
            border: 1px solid #0d6efd;
            color: #0d6efd;
            font-size: 0.8rem;
            font-weight: 700;
            padding: 0.3rem 0.75rem;
            border-radius: 50rem;
            box-shadow: 0 1px 2px rgba(13, 110, 253, 0.1);
        }
        .ta-pill-dropdown:focus {
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }
    </style>
</head>
<body>
    <div id="wrapper" class="d-flex">
        <div class="sidebar d-flex flex-column p-3">
            <div class="sidebar-heading py-3 mb-3 border-bottom sidebar-brand-sisurat">
                <img src="/img/bps.png" alt="Logo BPS" style="width: 38px; height: 38px; object-fit: contain; flex-shrink: 0;" onerror="this.src='/img/bps1.png'">
                <div>
                    <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem; line-height: 1.1;">PROGRES.NG</h6>
                    <small class="text-muted" style="font-size: 0.68rem; line-height: 1;">BPS Kab. Bangka Tengah</small>
                </div>
            </div>
            <ul class="nav flex-column mb-auto">
                <li class="nav-item mb-1"><a href="/" class="nav-item-link active-menu"><span><i class="fa-solid fa-gauge-high me-2"></i> Dashboard</span></a></li>
                <li class="nav-item mb-1"><a href="/entry" class="nav-item-link"><span><i class="fa-solid fa-folder-plus me-2"></i> Entri Kegiatan</span></a></li>
                <li class="nav-item mb-1"><a href="/pelaporan" class="nav-item-link"><span><i class="fa-solid fa-file-lines me-2"></i> Pelaporan</span></a></li>
            </ul>
            <div class="mt-auto pt-3 border-top text-center"><span class="badge bg-light text-dark border px-3 py-2 fw-semibold">TA <%= typeof selectedYear !== 'undefined' ? selectedYear : '2026' %></span></div>
        </div>

        <div class="flex-grow-1 d-flex flex-column" style="min-width: 0;">
            <nav class="navbar navbar-expand navbar-light bg-white border-bottom px-4 shadow-sm navbar-custom-uniform">
                <span class="navbar-brand mb-0 fw-bold text-secondary brand-title-small"><i class="fa-solid fa-chart-line text-primary me-2"></i> Sistem Monitoring Kinerja Tim (PROGRES.NG)</span>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <!-- Dropdown TA Simple Pill -->
                    <select class="form-select form-select-sm ta-pill-dropdown w-auto cursor-pointer" onchange="location = this.value;">
                        <option value="/?year=2026" <%= (typeof selectedYear !== 'undefined' && selectedYear === '2026') ? 'selected' : '' %>>📅 TA 2026</option>
                        <option value="/?year=2025" <%= (typeof selectedYear !== 'undefined' && selectedYear === '2025') ? 'selected' : '' %>>📅 TA 2025</option>
                        <option value="/?year=2027" <%= (typeof selectedYear !== 'undefined' && selectedYear === '2027') ? 'selected' : '' %>>📅 TA 2027</option>
                    </select>

                    <span id="realtimeClock" class="realtime-clock-modern"></span>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Online</span>
                </div>
            </nav>

            <div class="container-fluid dashboard-compact-container flex-grow-1">
                <div class="row g-3 mb-3 align-items-stretch">
                    <div class="col-lg-3 col-xl-2 d-flex flex-column justify-content-between gap-2" style="min-width: 220px;">
                        <div class="card stat-card-compact border-start border-primary border-4 bg-white shadow-sm flex-fill d-flex flex-column justify-content-center">
                            <span class="text-muted fw-bold stat-label">TOTAL KEGIATAN / SURVEI</span>
                            <div class="fw-bold text-dark stat-value mt-1"><%= totalActivities %></div>
                            <small class="text-primary d-block stat-sub"><i class="fa-solid fa-layer-group me-1"></i> Terdata dari 7 Tim Kerja</small>
                        </div>
                        <div class="card stat-card-compact border-start border-success border-4 bg-white shadow-sm flex-fill d-flex flex-column justify-content-center">
                            <span class="text-muted fw-bold stat-label">KEGIATAN SELESAI (100%)</span>
                            <div class="fw-bold text-success stat-value mt-1"><%= completedActivities %></div>
                            <small class="text-success d-block stat-sub"><i class="fa-solid fa-circle-check me-1"></i> Tuntas Tercapai</small>
                        </div>
                        <div class="card stat-card-compact border-start border-info border-4 bg-white shadow-sm flex-fill d-flex flex-column justify-content-center">
                            <span class="text-muted fw-bold stat-label">PROGRES KESELURUHAN BPS</span>
                            <div class="fw-bold text-info stat-value mt-1"><%= overallProgress %>%</div>
                            <small class="text-info d-block stat-sub"><i class="fa-solid fa-chart-line me-1"></i> Berdasarkan Bulan Terakhir Diisi</small>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card p-3 bg-white shadow-sm h-100 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold mb-0"><i class="fa-solid fa-chart-line text-primary me-2"></i> Tren Progres Pelaksanaan Bulanan (Januari - Desember)</h6>
                                <span class="small text-muted fw-semibold"><i class="fa-solid fa-circle text-primary me-1" style="font-size: 0.6rem;"></i> Progres Pelaksanaan (%)</span>
                            </div>
                            <div class="flex-grow-1" style="min-height: 255px; max-height: 285px;">
                                <canvas id="trendChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-lg-8">
                        <div class="card p-3 bg-white shadow-sm h-100">
                            <h6 class="fw-bold mb-2"><i class="fa-solid fa-users-rectangle text-primary me-2"></i> Akumulasi Capaian Progres per Tim</h6>
                            <div class="table-responsive">
                                <table class="table table-compact-dash align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Nama Tim Kerja</th>
                                            <th>Jumlah Kegiatan</th>
                                            <th>Capaian Progres (%)</th>
                                            <th class="text-center">Status Kinerja</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% teamProgress.forEach(t => { %>
                                            <tr>
                                                <td><strong>Tim <%= t.team %></strong></td>
                                                <td><%= t.total %> Kegiatan</td>
                                                <td style="width: 42%;">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="progress flex-grow-1" style="height: 8px; background-color: #e2e8f0;">
                                                            <div class="progress-bar bg-primary rounded" role="progressbar" style="width: <%= t.progress %>%"></div>
                                                        </div>
                                                        <small class="text-muted fw-semibold" style="min-width: 38px; text-align: right;"><%= t.progress %>%</small>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-<%= t.progress > 75 ? 'success' : (t.progress > 40 ? 'warning text-dark' : 'secondary') %>" style="font-size: 0.7rem;">
                                                        <%= t.progress > 75 ? 'Optimal' : 'Berjalan' %>
                                                    </span>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card p-3 bg-white shadow-sm h-100 d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="fw-bold mb-2"><i class="fa-solid fa-chart-pie text-success me-2"></i> Sebaran Status Pelaksanaan</h6>
                                <div>
                                    <div class="d-flex justify-content-between status-row-compact border-bottom"><span>Perencanaan (0%)</span><strong><%= statusCount['Perencanaan'] || 0 %></strong></div>
                                    <div class="d-flex justify-content-between status-row-compact border-bottom"><span>Persiapan (1-10%)</span><strong><%= statusCount['Persiapan'] || 0 %></strong></div>
                                    <div class="d-flex justify-content-between status-row-compact border-bottom"><span>Pelaksanaan (11-99%)</span><strong><%= statusCount['Pelaksanaan'] || 0 %></strong></div>
                                    <div class="d-flex justify-content-between status-row-compact border-bottom"><span>Selesai (100%)</span><strong><%= statusCount['Selesai'] || 0 %></strong></div>
                                    <div class="d-flex justify-content-between status-row-compact"><span>Belum Lapor</span><strong><%= statusCount['Belum Lapor'] || 0 %></strong></div>
                                </div>
                            </div>
                            <div class="pt-2 border-top mt-2">
                                <a href="/pelaporan" class="btn btn-sm btn-outline-primary w-100 fw-bold"><i class="fa-solid fa-pen-to-square me-1"></i> Buka Menu Pelaporan</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer style="background-color: #ffffff; border-top: 1px solid #e2e8f0; color: #0d6efd;" class="py-2 px-4 text-center small">
                <span>Badan Pusat Statistik Kabupaten Bangka Tengah &copy; 2026</span> &bull; <span class="fw-semibold">PROGRES.NG V1.0</span>
            </footer>
        </div>
    </div>

    <script>
        function updateClock() {
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' };
            document.getElementById('realtimeClock').innerHTML = '<i class="fa-regular fa-clock me-1 text-primary"></i> ' + now.toLocaleDateString('id-ID', options);
        }
        setInterval(updateClock, 1000);
        updateClock();

        const ctx = document.getElementById('trendChart').getContext('2d');
        const monthlyData = <%= JSON.stringify(monthlyTrend) %>;
        
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'],
                datasets: [{
                    label: 'Progres Pelaksanaan (%)',
                    data: monthlyData,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.08)',
                    borderWidth: 3,
                    tension: 0.35,
                    fill: true,
                    pointBackgroundColor: '#0d6efd',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#ffffff',
                        titleColor: '#1e293b',
                        bodyColor: '#0d6efd',
                        borderColor: '#e2e8f0',
                        borderWidth: 1,
                        padding: 10,
                        displayColors: true,
                        callbacks: {
                            label: function(context) {
                                return ' Pelaksanaan: ' + Number(context.parsed.y).toFixed(2) + '%';
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            stepSize: 20,
                            callback: function(value) { return value.toFixed(2); }
                        },
                        title: {
                            display: true,
                            text: 'Persentase (%)',
                            font: { size: 11, weight: 'bold' }
                        }
                    }
                }
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>