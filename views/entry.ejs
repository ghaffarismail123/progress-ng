<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entri Kegiatan - PROGRES.NG BPS Bangka Tengah</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        .table-entry-clean {
            border-collapse: collapse;
            width: 100%;
        }
        .table-entry-clean th {
            background-color: #212529 !important;
            color: #ffffff !important;
            border-top: 1px solid #212529;
            border-bottom: 2px solid #000000 !important;
            border-left: none !important;
            border-right: none !important;
            padding-top: 0.35rem !important;
            padding-bottom: 0.35rem !important;
            padding-left: 0.5rem !important;
            padding-right: 0.5rem !important;
            font-size: 0.79rem !important;
            vertical-align: middle;
        }
        .table-entry-clean td {
            border-top: none !important;
            border-bottom: 1px solid #e2e8f0 !important;
            border-left: none !important;
            border-right: none !important;
            padding-top: 0.28rem !important;
            padding-bottom: 0.28rem !important;
            padding-left: 0.5rem !important;
            padding-right: 0.5rem !important;
            font-size: 0.79rem !important;
            vertical-align: middle;
        }
        .table-entry-clean .btn {
            padding: 0.12rem 0.35rem !important;
            font-size: 0.71rem !important;
        }
        .sidebar-brand-sisurat {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-align: left !important;
        }
        .navbar-custom-uniform {
            padding-top: 0.75rem !important;
            padding-bottom: 0.75rem !important;
        }
        .brand-title-small {
            font-size: 0.875rem !important;
        }
        .realtime-clock-modern {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(6px);
            border: 1px solid rgba(226, 232, 240, 0.8);
            color: #475569;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.3rem 0.8rem;
            border-radius: 50rem;
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        }
        .ta-pill-dropdown {
            background: #ffffff;
            border: 1px solid #0d6efd;
            color: #0d6efd;
            font-size: 0.8rem;
            font-weight: 700;
            padding: 0.3rem 0.75rem;
            border-radius: 50rem;
            box-shadow: 0 1px 2px rgba(13, 110, 253, 0.1);
        }
        .ta-pill-dropdown:focus {
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }
    </style>
</head>
<body>
    <div id="wrapper" class="d-flex">
        <!-- Sidebar -->
        <div class="sidebar d-flex flex-column p-3">
            <div class="sidebar-heading py-3 mb-3 border-bottom sidebar-brand-sisurat">
                <img src="/img/bps.png" alt="Logo BPS" style="width: 38px; height: 38px; object-fit: contain; flex-shrink: 0;" onerror="this.src='/img/bps1.png'">
                <div>
                    <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem; line-height: 1.1;">PROGRES.NG</h6>
                    <small class="text-muted" style="font-size: 0.68rem; line-height: 1;">BPS Kab. Bangka Tengah</small>
                </div>
            </div>
            <ul class="nav flex-column mb-auto">
                <li class="nav-item mb-1"><a href="/" class="nav-item-link"><span><i class="fa-solid fa-gauge-high me-2"></i> Dashboard</span></a></li>
                <li class="nav-item mb-1"><a href="/entry" class="nav-item-link active-menu"><span><i class="fa-solid fa-folder-plus me-2"></i> Entri Kegiatan</span></a></li>
                <li class="nav-item mb-1"><a href="/pelaporan" class="nav-item-link"><span><i class="fa-solid fa-file-lines me-2"></i> Pelaporan</span></a></li>
            </ul>
            <div class="mt-auto pt-3 border-top text-center"><span class="badge bg-light text-dark border px-3 py-2 fw-semibold">TA <%= typeof selectedYear !== 'undefined' ? selectedYear : '2026' %></span></div>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1 d-flex flex-column" style="min-width: 0;">
            <nav class="navbar navbar-expand navbar-light bg-white border-bottom px-4 shadow-sm navbar-custom-uniform">
                <span class="navbar-brand mb-0 fw-bold text-secondary brand-title-small"><i class="fa-solid fa-chart-line text-primary me-2"></i> Sistem Monitoring Kinerja Tim (PROGRES.NG)</span>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <select class="form-select form-select-sm ta-pill-dropdown w-auto cursor-pointer" onchange="location = this.value;">
                        <option value="/entry?year=2026" <%= (typeof selectedYear !== 'undefined' && selectedYear === '2026') ? 'selected' : '' %>>📅 TA 2026</option>
                        <option value="/entry?year=2025" <%= (typeof selectedYear !== 'undefined' && selectedYear === '2025') ? 'selected' : '' %>>📅 TA 2025</option>
                        <option value="/entry?year=2027" <%= (typeof selectedYear !== 'undefined' && selectedYear === '2027') ? 'selected' : '' %>>📅 TA 2027</option>
                    </select>
                    <span id="realtimeClock" class="realtime-clock-modern"></span>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Online</span>
                </div>
            </nav>

            <div class="container-fluid p-4 flex-grow-1">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2>Entri & Manajemen Kegiatan</h2>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-danger fw-bold btn-sm" data-bs-toggle="modal" data-bs-target="#deleteAllModal"><i class="fa-solid fa-trash-can me-1"></i> Hapus Semua</button>
                        <button type="button" class="btn btn-success fw-bold btn-sm" data-bs-toggle="modal" data-bs-target="#importExcelModal"><i class="fa-solid fa-file-excel me-1"></i> Import Excel Kegiatan</button>
                        <button type="button" class="btn btn-primary fw-bold btn-sm" data-bs-toggle="modal" data-bs-target="#addActivityModal"><i class="fa-solid fa-plus me-1"></i> Tambah Kegiatan Baru</button>
                    </div>
                </div>

                <% if (typeof msg !== 'undefined' && msg) { %>
                    <div class="alert alert-info alert-dismissible fade show shadow-sm py-2" role="alert">
                        <i class="fa-solid fa-circle-info me-2"></i> <%= msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <!-- Search Bar -->
                <div class="card p-3 bg-white mb-4 shadow-sm">
                    <form action="/entry" method="GET" class="input-group">
                        <input type="text" name="search" class="form-control form-control-sm" placeholder="Cari nama kegiatan, kode RO, atau tim..." value="<%= search %>">
                        <button class="btn btn-dark btn-sm px-4" type="submit"><i class="fa-solid fa-search me-1"></i> Cari</button>
                        <% if (search) { %>
                            <a href="/entry" class="btn btn-outline-secondary btn-sm">Reset</a>
                        <% } %>
                    </form>
                </div>

                <!-- Tabel List Kegiatan -->
                <div class="card p-3 bg-white shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-entry-clean mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 4%;">#</th>
                                    <th style="width: 14%;">Tim Kerja</th>
                                    <th style="width: 16%;">Sub Tim</th>
                                    <th style="width: 13%;">Kode RO</th>
                                    <th>Nama Kegiatan / Survei</th>
                                    <th style="width: 12%;">Jenis</th>
                                    <th class="text-center" style="width: 14%;">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!activities || activities.length === 0) { %>
                                    <tr><td colspan="7" class="text-center text-muted py-4">Tidak ada kegiatan ditemukan. Klik "Import Excel Kegiatan" atau "Tambah Kegiatan Baru".</td></tr>
                                <% } else { %>
                                    <% activities.forEach((act, index) => { %>
                                        <tr>
                                            <td><%= index + 1 %></td>
                                            <td><span class="badge bg-secondary"><%= act.team %></span></td>
                                            <td><%= act.sub_team || '-' %></td>
                                            <td><code><%= act.ro_code %></code></td>
                                            <td><strong><%= act.name %></strong></td>
                                            <td><span class="badge bg-info text-dark"><%= act.jenis || 'Kegiatan' %></span></td>
                                            <td class="text-center">
                                                <div class="d-flex justify-content-center gap-1">
                                                    <!-- Tombol Sunting (Edit) -->
                                                    <button type="button" class="btn btn-sm btn-warning text-dark fw-semibold edit-activity-btn" 
                                                        data-id="<%= act.id %>"
                                                        data-team="<%= act.team %>"
                                                        data-sub-team="<%= act.sub_team || '' %>"
                                                        data-ro-code="<%= act.ro_code %>"
                                                        data-name="<%= act.name %>"
                                                        data-jenis="<%= act.jenis || '' %>"
                                                        data-bs-toggle="modal" data-bs-target="#editActivityModal" title="Sunting Kegiatan">
                                                        <i class="fa-solid fa-pen-to-square"></i> Sunting
                                                    </button>
                                                    <!-- Tombol Hapus -->
                                                    <form action="/entry/delete/<%= act.id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus kegiatan ini?')" class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-danger" title="Hapus Kegiatan"><i class="fa-solid fa-trash"></i></button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- POP-UP MODAL HAPUS SEMUA DENGAN PASSWORD -->
            <div class="modal fade" id="deleteAllModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-danger shadow">
                        <form action="/entry/delete-all" method="POST">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i> Konfirmasi Hapus Semua Data</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body py-4">
                                <div class="alert alert-warning mb-3">
                                    <strong>Peringatan:</strong> Tindakan ini akan menghapus <strong>seluruh daftar kegiatan</strong> beserta seluruh data progres pelaporannya secara permanen.
                                </div>
                                <div class="mb-2">
                                    <label for="deleteAllPassword" class="form-label fw-bold">Masukkan Password Konfirmasi</label>
                                    <input type="password" id="deleteAllPassword" name="password" class="form-control text-center fw-bold fs-5" placeholder="••••" required autocomplete="off">
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                                <button type="submit" class="btn btn-danger fw-bold"><i class="fa-solid fa-trash-can me-1"></i> Ya, Hapus Semua</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- POP-UP MODAL IMPORT EXCEL -->
            <div class="modal fade" id="importExcelModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form action="/entry/import" method="POST" enctype="multipart/form-data">
                            <div class="modal-header bg-success text-white">
                                <h5 class="modal-title"><i class="fa-solid fa-file-excel me-2"></i> Import Data Excel Kegiatan</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label for="excelFileInput" class="form-label fw-bold">Pilih File Excel (.xlsx / .xls)</label>
                                    <input type="file" id="excelFileInput" name="excel_file" class="form-control" accept=".xlsx,.xls" required>
                                    <div class="form-text text-muted mt-2">
                                        Mendukung format tabel (Tim Kerja, Sub Tim, Kode RO, Nama Kegiatan, Jenis) maupun file Caput BPS.
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                                <button type="submit" class="btn btn-success fw-bold">Mulai Import</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Modal Tambah Kegiatan -->
            <div class="modal fade" id="addActivityModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form action="/entry/add" method="POST">
                            <div class="modal-header bg-dark text-white">
                                <h5 class="modal-title">Tambah Kegiatan Baru</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Tim Kerja</label>
                                    <select name="team" class="form-select" required>
                                        <option value="Sosial">Sosial</option>
                                        <option value="Distribusi">Distribusi</option>
                                        <option value="Produksi">Produksi</option>
                                        <option value="Neraca">Neraca</option>
                                        <option value="IPDS">IPDS</option>
                                        <option value="Sektoral">Sektoral</option>
                                        <option value="Umum">Umum</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Sub Tim</label>
                                    <input type="text" name="sub_team" class="form-control" placeholder="Contoh: Neraca Produksi">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Kode RO / Akun</label>
                                    <input type="text" name="ro_code" class="form-control" placeholder="Contoh: 2899.BMA" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Nama Kegiatan / Survei</label>
                                    <textarea name="name" class="form-control" rows="2" placeholder="Nama survei/kegiatan..." required></textarea>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Jenis</label>
                                    <input type="text" name="jenis" class="form-control" placeholder="Contoh: Survei / Laporan / Pendataan">
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                                <button type="submit" class="btn btn-primary">Simpan Kegiatan</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Modal Sunting / Edit Kegiatan -->
            <div class="modal fade" id="editActivityModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form action="/entry/edit" method="POST" class="modal-content">
                        <div class="modal-header bg-warning text-dark">
                            <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i> Sunting Kegiatan</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="id" id="editActivityId">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Tim Kerja</label>
                                <select name="team" id="editActivityTeam" class="form-select" required>
                                    <option value="Sosial">Sosial</option>
                                    <option value="Distribusi">Distribusi</option>
                                    <option value="Produksi">Produksi</option>
                                    <option value="Neraca">Neraca</option>
                                    <option value="IPDS">IPDS</option>
                                    <option value="Sektoral">Sektoral</option>
                                    <option value="Umum">Umum</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Sub Tim</label>
                                <input type="text" name="sub_team" id="editActivitySubTeam" class="form-control" placeholder="Contoh: Neraca Produksi">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Kode RO / Akun</label>
                                <input type="text" name="ro_code" id="editActivityRoCode" class="form-control" placeholder="Contoh: 2899.BMA" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Nama Kegiatan / Survei</label>
                                <textarea name="name" id="editActivityName" class="form-control" rows="2" placeholder="Nama survei/kegiatan..." required></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Jenis</label>
                                <input type="text" name="jenis" id="editActivityJenis" class="form-control" placeholder="Contoh: Survei / Laporan / Pendataan">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                            <button type="submit" class="btn btn-warning fw-bold text-dark">Simpan Perubahan</button>
                        </div>
                    </form>
                </div>
            </div>

            <footer style="background-color: #ffffff; border-top: 1px solid #e2e8f0; color: #0d6efd;" class="py-2 px-4 text-center small">
                <span>Badan Pusat Statistik Kabupaten Bangka Tengah &copy; 2026</span> &bull; <span class="fw-semibold">PROGRES.NG V1.0</span>
            </footer>
        </div>
    </div>

    <script>
        function updateClock() {
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' };
            document.getElementById('realtimeClock').innerHTML = '<i class="fa-regular fa-clock me-1 text-primary"></i> ' + now.toLocaleDateString('id-ID', options);
        }
        setInterval(updateClock, 1000);
        updateClock();

        document.addEventListener('DOMContentLoaded', () => {
            const editModal = document.getElementById('editActivityModal');
            if (editModal) {
                editModal.addEventListener('show.bs.modal', (event) => {
                    const button = event.relatedTarget;
                    document.getElementById('editActivityId').value = button.getAttribute('data-id');
                    document.getElementById('editActivityTeam').value = button.getAttribute('data-team');
                    document.getElementById('editActivitySubTeam').value = button.getAttribute('data-sub-team');
                    document.getElementById('editActivityRoCode').value = button.getAttribute('data-ro-code');
                    document.getElementById('editActivityName').value = button.getAttribute('data-name');
                    document.getElementById('editActivityJenis').value = button.getAttribute('data-jenis');
                });
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>